# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=

# Qdrant vector DB URL (default if running locally via Docker)
QDRANT_URL=http://localhost:6333

# Hugging Face token — for reliable model downloads (free tier)
HF_TOKEN=

# Silences noisy HF symlink warnings on Windows (safe to leave as-is)
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=